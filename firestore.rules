rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // ===============================================================
    // Shared Helpers
    // ===============================================================
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      // Bootstrap Admin + Checked Admin
      return isVerified() && (
        request.auth.token.email == "lastry-thone@hotmail.com" || 
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // ===============================================================
    // Validators
    // ===============================================================
    
    function isValidGameState(data) {
      return data.keys().hasAll(['status', 'difficulty', 'lastUpdated']) &&
             data.status in ['START_MENU', 'CREATION', 'STAGE_SETUP', 'PLAYING', 'GAME_OVER'] &&
             data.difficulty in ['normal', 'grand'] &&
             data.lastUpdated == request.time &&
             (!('character' in data) || data.character == null || data.character is map) &&
             (!('selectedStages' in data) || data.selectedStages is list);
    }

    function isValidMessage(data) {
      return data.keys().hasAll(['id', 'role', 'content']) &&
             data.keys().size() == 3 &&
             isValidId(data.id) &&
             data.role in ['user', 'model'] &&
             data.content is string && data.content.size() <= 20000;
    }

    function isValidNPC(data) {
      return data.keys().hasAll(['id', 'name', 'lastUpdated']) &&
             isValidId(data.id) &&
             data.name is string && data.name.size() <= 100 &&
             data.lastUpdated == request.time;
    }

    // ===============================================================
    // Match Rules
    // ===============================================================

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) && incoming().keys().hasOnly(['email', 'displayName', 'photoURL', 'createdAt']) && incoming().createdAt == request.time;
      allow update: if isOwner(userId) && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL']);
    }

    match /games/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) && isValidGameState(incoming());
      allow update: if isOwner(userId) && isValidGameState(incoming());
      allow delete: if isOwner(userId) || isAdmin();

      match /history/{messageId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidMessage(incoming());
        allow list: if isOwner(userId);
        // Messages are immutable
      }

      match /npcs/{npcId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidNPC(incoming());
        allow update: if isOwner(userId) && isValidNPC(incoming());
        allow delete: if isOwner(userId);
        allow list: if isOwner(userId);
      }

      match /logs/{logId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && incoming().keys().hasAll(['timestamp', 'content']) && incoming().timestamp == request.time;
        allow list: if isOwner(userId);
      }
    }

    match /admins/{userId} {
      allow read: if isAdmin();
    }
  }
}

